<Project>
  <PropertyGroup>
    <!-- Local/dev default only; the release workflow stamps the real version via -p:Version from the release tag. -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>Adam Davies</Authors>
    <Product>Log Dug</Product>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <AxialGuardrailsSeverity>error</AxialGuardrailsSeverity>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Axial.Guardrails" PrivateAssets="all" />
  </ItemGroup>
</Project>
