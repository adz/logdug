{
  "service": "orders-api",
  "listen": { "host": "0.0.0.0", "port": 8080 },
  "database": {
    "host": "db.internal",
    "port": 5432,
    "pool": { "min": 2, "max": 20, "idleTimeoutSeconds": 30 }
  },
  "logging": {
    "level": "Information",
    "sinks": [
      { "type": "console", "format": "compact" },
      { "type": "file", "path": "/var/log/orders/orders-api.log", "rollingInterval": "day" }
    ]
  },
  "features": ["fast-checkout", "saved-cards", "gift-wrap"]
}
