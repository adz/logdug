<Project>
  <PropertyGroup>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="11.0.100" />

    <PackageVersion Include="Axial" Version="0.10.0" />
    <PackageVersion Include="Axial.FileSystem" Version="0.10.0" />
    <PackageVersion Include="Axial.PlatformService" Version="0.10.0" />
    <PackageVersion Include="Axial.Guardrails" Version="0.10.0" />
    <PackageVersion Include="Reified.Schema" Version="0.10.0" />
    <PackageVersion Include="Elmish" Version="5.0.2" />
    <PackageVersion Include="Elmish.Avalonia.Glue" Version="0.1.0" />
    <PackageVersion Include="Elmish.Avalonia.Glue.Projection" Version="0.1.0" />

    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
