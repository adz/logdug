<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icons -->
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
    </Style>

    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ToneMuted}" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource ToneMuted}" />
    </Style>

    <!-- Segment tones (runs inside log text blocks) -->
    <Style Selector="Run.tone-muted"><Setter Property="Foreground" Value="{DynamicResource ToneMuted}" /></Style>
    <Style Selector="Run.tone-string"><Setter Property="Foreground" Value="{DynamicResource ToneString}" /></Style>
    <Style Selector="Run.tone-number"><Setter Property="Foreground" Value="{DynamicResource ToneNumber}" /></Style>
    <Style Selector="Run.tone-keyword"><Setter Property="Foreground" Value="{DynamicResource ToneKeyword}" /></Style>
    <Style Selector="Run.tone-key"><Setter Property="Foreground" Value="{DynamicResource ToneKey}" /></Style>
    <Style Selector="Run.tone-punct"><Setter Property="Foreground" Value="{DynamicResource TonePunct}" /></Style>
    <Style Selector="Run.tone-exception">
        <Setter Property="Foreground" Value="{DynamicResource ToneException}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Run.tone-link">
        <Setter Property="Foreground" Value="{DynamicResource ToneLink}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Run.tone-id"><Setter Property="Foreground" Value="{DynamicResource ToneId}" /></Style>
    <Style Selector="Run.tone-frame"><Setter Property="Foreground" Value="{DynamicResource ToneFrame}" /></Style>
    <Style Selector="Run.hit">
        <Setter Property="Background" Value="{DynamicResource HitBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource HitForeground}" />
    </Style>

    <!-- Level badges -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="0,1" />
        <Setter Property="Width" Value="50" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge.level-trace"><Setter Property="Background" Value="{DynamicResource LevelTraceSoft}" /></Style>
    <Style Selector="Border.badge.level-trace > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LevelTrace}" /></Style>
    <Style Selector="Border.badge.level-debug"><Setter Property="Background" Value="{DynamicResource LevelDebugSoft}" /></Style>
    <Style Selector="Border.badge.level-debug > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LevelDebug}" /></Style>
    <Style Selector="Border.badge.level-info"><Setter Property="Background" Value="{DynamicResource LevelInfoSoft}" /></Style>
    <Style Selector="Border.badge.level-info > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LevelInfo}" /></Style>
    <Style Selector="Border.badge.level-warn"><Setter Property="Background" Value="{DynamicResource LevelWarnSoft}" /></Style>
    <Style Selector="Border.badge.level-warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LevelWarn}" /></Style>
    <Style Selector="Border.badge.level-error"><Setter Property="Background" Value="{DynamicResource LevelErrorSoft}" /></Style>
    <Style Selector="Border.badge.level-error > TextBlock"><Setter Property="Foreground" Value="{DynamicResource LevelError}" /></Style>
    <Style Selector="Border.badge.level-fatal"><Setter Property="Background" Value="{DynamicResource LevelFatal}" /></Style>
    <Style Selector="Border.badge.level-fatal > TextBlock"><Setter Property="Foreground" Value="#FFFFFF" /></Style>
    <Style Selector="Border.badge.level-none"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Border.badge.level-none > TextBlock"><Setter Property="Foreground" Value="{DynamicResource GutterBrush}" /></Style>

    <!-- Entry rows: a soft tint and accent bar for warnings and worse -->
    <Style Selector="Border.entry">
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0,3,12,3" />
    </Style>
    <Style Selector="Border.entry.level-warn">
        <Setter Property="Background" Value="{DynamicResource RowWarnTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LevelWarn}" />
    </Style>
    <Style Selector="Border.entry.level-error">
        <Setter Property="Background" Value="{DynamicResource RowErrorTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LevelError}" />
    </Style>
    <Style Selector="Border.entry.level-fatal">
        <Setter Property="Background" Value="{DynamicResource RowFatalTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LevelFatal}" />
    </Style>

    <!-- The entries list: flat rows, accent on selection -->
    <Style Selector="ListBox.entries">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.entries ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.entries ListBoxItem /template/ Border#HoverBackground">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="ListBox.entries ListBoxItem /template/ Border#SelectionBackground">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
    </Style>
    <Style Selector="ListBox.entries ListBoxItem:selected /template/ PathIcon#CheckSelected">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Tree and result rows are flat buttons -->
    <Style Selector="Button.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="Button.row.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
    </Style>
    <Style Selector="Button.row.selected TextBlock.name">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.qo.selected"><Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" /></Style>

    <!-- Scrollbars stay visible rather than fading out until the pointer is near -->
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="False" /></Style>
    <Style Selector="ScrollBar"><Setter Property="AllowAutoHide" Value="False" /></Style>

    <Style Selector="TextBlock.kind-folder"><Setter Property="Foreground" Value="{DynamicResource FolderBrush}" /></Style>
    <Style Selector="TextBlock.kind-archive"><Setter Property="Foreground" Value="{DynamicResource ArchiveBrush}" /></Style>
    <Style Selector="TextBlock.kind-file"><Setter Property="Foreground" Value="{DynamicResource FileBrush}" /></Style>

    <Style Selector="TextBlock.spin">
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Segmented toggle groups (time zone mode, search options) -->
    <Style Selector="Border.segmented">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Border.segmented ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource ToneMuted}" />
    </Style>
    <Style Selector="Border.segmented ToggleButton:checked">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    <Style Selector="Border.segmented ToggleButton:checked /template/ Border#NameHoverBackground">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>

    <!-- Search option toggles inside the search box -->
    <Style Selector="ToggleButton.option">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource ToneMuted}" />
    </Style>
    <Style Selector="ToggleButton.option:checked /template/ Border#NameHoverBackground">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.option:checked">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Level filter chips -->
    <Style Selector="ToggleButton.chip">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="ToggleButton.chip:checked">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ Border#NameHoverBackground">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
    <Style Selector="TextBlock.status"><Setter Property="Foreground" Value="{DynamicResource ToneMuted}" /></Style>
    <Style Selector="TextBlock.status.error"><Setter Property="Foreground" Value="{DynamicResource LevelError}" /></Style>
    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot.level-trace"><Setter Property="Fill" Value="{DynamicResource LevelTrace}" /></Style>
    <Style Selector="Ellipse.dot.level-debug"><Setter Property="Fill" Value="{DynamicResource LevelDebug}" /></Style>
    <Style Selector="Ellipse.dot.level-info"><Setter Property="Fill" Value="{DynamicResource LevelInfo}" /></Style>
    <Style Selector="Ellipse.dot.level-warn"><Setter Property="Fill" Value="{DynamicResource LevelWarn}" /></Style>
    <Style Selector="Ellipse.dot.level-error"><Setter Property="Fill" Value="{DynamicResource LevelError}" /></Style>
    <Style Selector="Ellipse.dot.level-fatal"><Setter Property="Fill" Value="{DynamicResource LevelFatal}" /></Style>
    <Style Selector="Ellipse.dot.level-none"><Setter Property="Fill" Value="{DynamicResource GutterBrush}" /></Style>

    <!-- Search results -->
    <Style Selector="Button.row.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Run.match">
        <Setter Property="Background" Value="{DynamicResource HitBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource HitForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="MinWidth" Value="1" />
        <Setter Property="MinHeight" Value="1" />
    </Style>
</Styles>
