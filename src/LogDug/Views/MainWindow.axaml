<shadui:Window
    x:Class="LogDug.UI.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:ui="clr-namespace:LogDug.UI"
    xmlns:core="clr-namespace:LogDug;assembly=LogDug.Core"
    x:DataType="ui:MainVm"
    Title="Log Dug"
    TitleFontWeight="SemiBold"
    Width="1480"
    Height="900"
    MinWidth="960"
    MinHeight="560"
    WindowStartupLocation="CenterScreen">

    <shadui:Window.KeyBindings>
        <KeyBinding Gesture="F3" Command="{Binding NextHitCommand}" />
        <KeyBinding Gesture="Shift+F3" Command="{Binding PreviousHitCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
    </shadui:Window.KeyBindings>

    <shadui:Window.LogoContent>
        <TextBlock Classes="icon" Text="&#xe5f4;" Margin="12,0,0,0" Foreground="{DynamicResource AccentBrush}" />
    </shadui:Window.LogoContent>

    <shadui:Window.RightWindowTitleBarContent>
        <Button Classes="Ghost" Width="30" Height="30" Padding="0" Margin="0,0,6,0"
                ToolTip.Tip="Switch light / dark" Command="{Binding ToggleThemeCommand}">
            <Panel>
                <TextBlock Classes="icon" Text="&#xe178;" IsVisible="{Binding IsDark}" />
                <TextBlock Classes="icon" Text="&#xe11e;" IsVisible="{Binding !IsDark}" />
            </Panel>
        </Button>
    </shadui:Window.RightWindowTitleBarContent>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource PanelBrush}">

        <!-- Toolbar: search and time display -->
        <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox x:Name="SearchBox"
                             Width="560"
                             Height="36"
                             PlaceholderText="Search every file, including inside archives   (Ctrl+F)"
                             Text="{Binding SearchText, Mode=TwoWay}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding NextHitCommand}" />
                            <KeyBinding Gesture="Shift+Enter" Command="{Binding PreviousHitCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.KeyBindings>
                        <TextBox.InnerLeftContent>
                            <TextBlock Classes="icon muted" Text="&#xe151;" Margin="10,0,4,0" FontSize="14" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,5,0">
                                <Button Classes="Ghost" Width="26" Height="26" Padding="0" ToolTip.Tip="Clear (Esc)"
                                        IsVisible="{Binding HasSearchText}" Command="{Binding ClearSearchCommand}">
                                    <TextBlock Classes="icon muted" Text="&#xe1b2;" FontSize="13" />
                                </Button>
                                <ToggleButton Classes="option" ToolTip.Tip="Match case"
                                              IsChecked="{Binding IsMatchCase, Mode=OneWay}"
                                              Command="{Binding ToggleMatchCaseCommand}">
                                    <TextBlock Classes="icon" Text="&#xe3d9;" FontSize="15" />
                                </ToggleButton>
                                <ToggleButton Classes="option" ToolTip.Tip="Regular expression"
                                              IsChecked="{Binding IsRegex, Mode=OneWay}"
                                              Command="{Binding ToggleRegexCommand}">
                                    <TextBlock Classes="icon" Text="&#xe1fc;" FontSize="15" />
                                </ToggleButton>
                            </StackPanel>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding HasSearch}">
                        <Button Classes="Ghost" Width="30" Height="30" Padding="0" ToolTip.Tip="Previous match (Shift+F3)" Command="{Binding PreviousHitCommand}">
                            <TextBlock Classes="icon" Text="&#xe04a;" />
                        </Button>
                        <Button Classes="Ghost" Width="30" Height="30" Padding="0" ToolTip.Tip="Next match (F3)" Command="{Binding NextHitCommand}">
                            <TextBlock Classes="icon" Text="&#xe042;" />
                        </Button>
                        <TextBlock Text="{Binding CursorText}" VerticalAlignment="Center" Margin="4,0,0,0"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12" Classes="muted" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Classes="icon muted" Text="&#xe087;" />
                    <Border Classes="segmented">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton Content="UTC" IsChecked="{Binding IsUtc, Mode=OneWay}" Command="{Binding ShowUtcCommand}" />
                            <ToggleButton Content="Local" IsChecked="{Binding IsLocal, Mode=OneWay}" Command="{Binding ShowLocalCommand}" />
                            <ToggleButton Content="Zone" IsChecked="{Binding IsZone, Mode=OneWay}" Command="{Binding ShowZoneCommand}" />
                        </StackPanel>
                    </Border>
                    <ComboBox Width="290" Height="34"
                              ItemsSource="{Binding Zones}"
                              SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                              ToolTip.Tip="Target time zone">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="core:ZoneOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" x:Name="Body" ColumnDefinitions="300,1,*,1,400">

            <!-- File tree -->
            <DockPanel Grid.Column="0" Background="{DynamicResource PanelBrush}">
                <StackPanel DockPanel.Dock="Top" Margin="16,14,12,8" Spacing="2">
                    <TextBlock Classes="caption" Text="EXPLORER" />
                    <TextBlock Text="{Binding RootName}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RootPath}" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TreeRows}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:TreeRowVm">
                                <Button Classes="row" Classes.selected="{Binding IsSelected}" Height="28"
                                        Command="{Binding ActivateCommand}" ToolTip.Tip="{Binding Tip}">
                                    <Grid ColumnDefinitions="Auto,16,22,*,Auto" Margin="{Binding Indent}">
                                        <TextBlock Grid.Column="1" Classes="icon muted" FontSize="13" Text="{Binding Chevron}" />
                                        <TextBlock Grid.Column="2" Classes="icon" Classes.kind-folder="{Binding IsFolder}" Classes.kind-archive="{Binding IsArchive}" Classes.kind-file="{Binding IsFile}"
                                                   FontSize="14" Text="{Binding Icon}" />
                                        <TextBlock Grid.Column="3" Classes="name" Text="{Binding Name}" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" />
                                        <Panel Grid.Column="4" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Classes="muted" VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsLoading}" />
                                            <TextBlock Classes="icon muted spin" Text="&#xe10a;" FontSize="12" IsVisible="{Binding IsLoading}">
                                                <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Panel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <!-- Viewer -->
            <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <!-- Empty state -->
                <StackPanel IsVisible="{Binding ShowEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <TextBlock Classes="icon" Text="&#xe45f;" FontSize="48" Foreground="{DynamicResource AccentBrush}" Opacity="0.8" />
                    <TextBlock Text="Pick a log on the left" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"
                               Text="Zip and tar.gz archives open like folders. Search runs across every file, archives included." />
                </StackPanel>

                <Grid IsVisible="{Binding HasFile}" RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <!-- File header -->
                    <Border Grid.Row="0" Padding="18,12,14,10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="{Binding ViewerTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ToggleButton Classes="option" Height="30" Padding="10,0" ToolTip.Tip="Follow: reload when the file changes and keep the newest entries in view"
                                              IsChecked="{Binding IsFollowing, Mode=OneWay}" Command="{Binding ToggleFollowCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="icon" Text="&#xe038;" FontSize="14" />
                                        <TextBlock Text="Follow" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button Classes="Ghost" Width="30" Height="30" Padding="0" ToolTip.Tip="Reload (F5)" Command="{Binding ReloadCommand}">
                                    <TextBlock Classes="icon" Text="&#xe145;" />
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{Binding ViewerSummary}" Classes="muted" FontSize="12" Margin="0,3,0,0" />
                        </Grid>
                    </Border>

                    <!-- Level chips and column header -->
                    <Border Grid.Row="1" Padding="14,8" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                            IsVisible="{Binding ShowEntries}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding EntryCountText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="999" Padding="9,2">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Classes="icon" Text="&#xe0e8;" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Text="{Binding TimeCaption}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding LevelChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ui:LevelChipVm">
                                            <ToggleButton Classes="chip" IsChecked="{Binding IsOn, Mode=OneWay}" Command="{Binding ToggleCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Ellipse Classes="dot" Classes.level-trace="{Binding IsTrace}" Classes.level-debug="{Binding IsDebug}" Classes.level-info="{Binding IsInfo}" Classes.level-warn="{Binding IsWarn}" Classes.level-error="{Binding IsError}" Classes.level-fatal="{Binding IsFatal}" Classes.level-none="{Binding IsUnlevelled}" />
                                                    <TextBlock Text="{Binding Label}" />
                                                    <TextBlock Text="{Binding CountText}" Classes="muted" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="Ghost" Height="26" Padding="8,0" Margin="6,0,0,0" FontSize="12" Content="Show all"
                                        IsVisible="{Binding !AllLevelsShown}" Command="{Binding ShowAllLevelsCommand}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- Entries -->
                    <ListBox Grid.Row="2" x:Name="EntriesList" Classes="entries"
                             IsVisible="{Binding ShowEntries}"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="ui:EntryVm">
                                <Border Classes="entry" Classes.level-trace="{Binding IsTrace}" Classes.level-debug="{Binding IsDebug}" Classes.level-info="{Binding IsInfo}" Classes.level-warn="{Binding IsWarn}" Classes.level-error="{Binding IsError}" Classes.level-fatal="{Binding IsFatal}" Classes.level-none="{Binding IsUnlevelled}">
                                    <Grid ColumnDefinitions="64,186,60,*">
                                        <TextBlock Grid.Column="0" Classes="mono" Text="{Binding LineText}" Foreground="{DynamicResource GutterBrush}"
                                                   HorizontalAlignment="Right" Margin="0,0,14,0" />
                                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TimeText}" Foreground="{DynamicResource TimeBrush}" />
                                        <Border Grid.Column="2" Classes="badge" Classes.level-trace="{Binding IsTrace}" Classes.level-debug="{Binding IsDebug}" Classes.level-info="{Binding IsInfo}" Classes.level-warn="{Binding IsWarn}" Classes.level-error="{Binding IsError}" Classes.level-fatal="{Binding IsFatal}" Classes.level-none="{Binding IsUnlevelled}" IsVisible="{Binding HasLevel}">
                                            <TextBlock Text="{Binding LevelText}" />
                                        </Border>
                                        <ui:LogLine Grid.Column="3" Classes="mono" TextWrapping="Wrap" Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Unreadable / binary / empty -->
                    <StackPanel Grid.Row="2" IsVisible="{Binding HasViewerMessage}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Classes="icon muted" Text="&#xe0cc;" FontSize="36" />
                        <TextBlock Text="{Binding ViewerMessage}" Classes="muted" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Loading -->
                    <StackPanel Grid.Row="2" IsVisible="{Binding IsOpening}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Orientation="Horizontal">
                        <TextBlock Classes="icon spin" Text="&#xe10a;" FontSize="20" Foreground="{DynamicResource AccentBrush}">
                            <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="Reading…" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Detail of the selected entry -->
                    <GridSplitter Grid.Row="3" ResizeDirection="Rows" Height="1" IsVisible="{Binding HasDetail}" />
                    <Border Grid.Row="4" IsVisible="{Binding HasDetail}" Background="{DynamicResource PanelBrush}" MaxHeight="320">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="18,10,10,4">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DetailHeader}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DetailTimes}" Classes="muted mono" FontSize="11.5" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="Ghost" Width="28" Height="28" Padding="0" VerticalAlignment="Top"
                                        ToolTip.Tip="Close" Command="{Binding CloseDetailCommand}">
                                    <TextBlock Classes="icon" Text="&#xe1b2;" FontSize="13" />
                                </Button>
                            </Grid>
                            <ScrollViewer Margin="18,4,10,12">
                                <SelectableTextBlock Classes="mono" Text="{Binding DetailText}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" ResizeDirection="Columns" IsVisible="{Binding HasSearch}" />

            <!-- Search results -->
            <DockPanel Grid.Column="4" Background="{DynamicResource PanelBrush}" IsVisible="{Binding HasSearch}">
                <StackPanel DockPanel.Dock="Top" Margin="16,14,12,8" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="caption" Text="RESULTS" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="icon spin" Text="&#xe10a;" FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                   IsVisible="{Binding IsSearching}">
                            <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding SearchStatus}" FontSize="12" TextWrapping="Wrap"
                               Classes="status" Classes.error="{Binding IsSearchInvalid}" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Results}" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:ResultRowVm">
                                <Panel>
                                    <Button Classes="row" MinHeight="40" Margin="6,8,6,0" IsVisible="{Binding IsHeader}"
                                            Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Path}">
                                        <Grid ColumnDefinitions="22,*,Auto" Margin="8,4">
                                            <TextBlock Classes="icon kind-file" Text="&#xe0cc;" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="1" Margin="4,0,8,0">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding Path}" Classes="muted" FontSize="11" TextTrimming="LeadingCharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource RaisedBrush}" CornerRadius="999" Padding="7,1" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Count}" FontSize="11" FontFamily="{StaticResource MonoFont}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button Classes="row" Classes.active="{Binding IsActive}" MinHeight="24" IsVisible="{Binding IsHit}"
                                            Command="{Binding OpenCommand}">
                                        <Grid ColumnDefinitions="52,*" Margin="8,3">
                                            <TextBlock Classes="mono" Text="{Binding LineText}" Foreground="{DynamicResource GutterBrush}"
                                                       FontSize="11.5" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Before}" Foreground="{DynamicResource ToneMuted}" /><Run Classes="match" Text="{Binding Matched}" /><Run Text="{Binding After}" Foreground="{DynamicResource ToneMuted}" />
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="14,5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon muted" Text="&#xe0d7;" FontSize="12" />
                    <TextBlock Text="{Binding RootPath}" Classes="muted" FontSize="11.5" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Classes="muted" FontSize="11.5" Text="Ctrl+F search · Enter / F3 next · Shift+F3 previous · Esc clear · F5 reload" />
                    <TextBlock Classes="muted" FontSize="11.5" Text="{Binding TimeCaption, StringFormat='Times in {0}'}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</shadui:Window>
